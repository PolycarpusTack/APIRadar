{
  "name": "radar-monitor",
  "private": true,
  "scripts": {
    "dev:ui": "pnpm --filter radar-ui dev",
    "dev:desktop": "pnpm --filter radar-desktop dev",
    "build:ui": "pnpm --filter radar-ui build",
    "build:desktop": "pnpm --filter radar-desktop build",
    "lint": "pnpm --filter radar-ui lint",
    "vendor:scalar": "node -e \"const fs=require('fs');fs.mkdirSync('radar-api/vendor',{recursive:true});fs.copyFileSync('node_modules/@scalar/api-reference/dist/browser/standalone.js','radar-api/vendor/scalar.js');console.log('Vendored @scalar/api-reference ' + require('./node_modules/@scalar/api-reference/package.json').version);\""
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "@esbuild/win32-x64"
    ]
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "dependencies": {
    "@scalar/api-reference": "^1.67.0"
  }
}
