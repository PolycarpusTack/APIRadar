{
  "appId": "com.radarmonitor.desktop",
  "productName": "API Radar",
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "files": [
    "out/**/*",
    "!node_modules/**/*"
  ],
  "win": {
    "icon": "resources/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../target/release/radar-api.exe",
        "to": "radar-api.exe"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    ],
    "category": "public.app-category.developer-tools",
    "extraResources": [
      {
        "from": "../target/release/radar-api",
        "to": "radar-api"
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": [
          "x64"
        ]
      }
    ],
    "category": "Development",
    "extraResources": [
      {
        "from": "../target/release/radar-api",
        "to": "radar-api"
      }
    ],
    "icon": "resources/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "API Radar",
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "runAfterFinish": true,
    "deleteAppDataOnUninstall": false
  }
}
