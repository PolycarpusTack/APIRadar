{
  "appId": "com.radarmonitor.desktop",
  "productName": "API Radar",
  "icon": "resources/icon.ico",
  "directories": {
    "output": "dist",
    "buildResources": "resources"
  },
  "files": [
    "out/**/*",
    "!node_modules/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "extraResources": [
      {
        "from": "../../target/release/radar-api.exe",
        "to": "radar-api.exe"
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "extraResources": [
      {
        "from": "../../target/release/radar-api",
        "to": "radar-api"
      }
    ]
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "category": "Development",
    "extraResources": [
      {
        "from": "../../target/release/radar-api",
        "to": "radar-api"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
