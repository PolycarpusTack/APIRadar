{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "outDir": "out",
    "types": ["node"]
  },
  "include": [
    "electron/main/**/*.ts",
    "electron/preload/**/*.ts",
    "electron.vite.config.ts"
  ]
}
