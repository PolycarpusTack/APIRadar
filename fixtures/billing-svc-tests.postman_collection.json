{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Billing Service Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get User by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{id}",
          "host": ["{{base_url}}"],
          "path": ["users", "{id}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('phone field present', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.phone).to.exist;",
              "  pm.expect(json.email).to.not.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"user_id\": \"123\"}"
        },
        "url": {
          "raw": "{{base_url}}/orders",
          "host": ["{{base_url}}"],
          "path": ["orders"]
        }
      },
      "event": []
    },
    {
      "name": "Get Order Status (variable prefix)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}{{api_prefix}}/orders/{id}/status",
          "host": ["{{base_url}}"],
          "path": ["{{api_prefix}}", "orders", "{id}", "status"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var data = pm.response.json();",
              "pm.expect(data.status).to.be.a('string');"
            ],
            "type": "text/javascript"
          }
        }
      ]
    }
  ]
}
