{
  "info": {
    "name": "mobile-smoke-consumer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get user",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/users/{{userId}}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "pm.expect(json.phone).to.exist;"
            ]
          }
        }
      ]
    }
  ]
}
