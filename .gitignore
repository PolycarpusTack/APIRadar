# =============================================================================
# Rust
# =============================================================================
target/
**/*.rs.bk
# Cargo.lock is committed — workspace contains binary crates

# Vendored third-party assets (committed intentionally — do NOT gitignore)
# radar-api/vendor/scalar.js  ← Scalar standalone bundle, updated via `pnpm vendor:scalar`

# =============================================================================
# Node / pnpm
# =============================================================================
node_modules/
dist/
.next/
# pnpm-lock.yaml is intentionally NOT ignored — keep it in source control.
# This is a pnpm workspace: a root npm package-lock.json is stray (N-36).
package-lock.json

# =============================================================================
# Environment / secrets
# =============================================================================
.env
.env.local
.env.*.local
*.env

# =============================================================================
# SQLite databases (N-36: never commit local dev/test databases)
# =============================================================================
*.db
# Explicit local dev/test database names (also covered by *.db above):
drift.db
radar.db
*.sqlite
*.sqlite3

